        "sidebar.background": "#1b1f27",
        "sidebar.border": "#43464e",
        "sidebar.foreground": "#dcdfe4",
        "tab.active.background": "#3A404A",
        "tab.active.foreground": "#dcdfe4",
        "tab.background": "#2C313A",
        "tab.foreground": "#70737a",
        "tab_bar.background": "#1e1f24",
        "tab_bar.segmented.background": "#2C313A",
        "base.magenta.light": "#865999",
        "base.red": "#e06c75",
        "base.green": "#98c379",
        "base.yellow": "#e5c07b",
        "base.blue": "#61afef",
