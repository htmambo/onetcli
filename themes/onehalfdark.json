            "color": "#61afef"
          },
          "number": {
            "color": "#e06c75"
          },
          "operator": {
            "color": "#dcdfe4"
          },
          "predefined": {
            "color": "#56b6c2"
          },
          "string": {
            "color": "#98c379"
          },
          "type": {
            "color": "#56b6c2"
