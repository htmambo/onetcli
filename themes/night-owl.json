        "border": "#203444",
        "danger.active.background": "#ef5350",
        "danger.background": "#320610",
        "danger.foreground": "#ef5350",
        "danger.hover.background": "#320610",
        "foreground": "#d6deeb",
        "input.border": "#203444",
        "link.active": "#82aaff",
        "link": "#82aaff",
        "link.hover": "#82aaff",
        "list.active.background": "#0d223366",
        "list.active.border": "#82aaff",
        "list.even.background": "#011827",
        "muted.background": "#00091a",
        "muted.foreground": "#566675",
        "popover.background": "#011627",
        "popover.foreground": "#d6deeb",
        "primary.background": "#addb67",
        "primary.foreground": "#011627",
        "primary.hover.background": "#d3ff8d",
        "ring": "#82aaff",
        "scrollbar.background": "#01162700",
        "scrollbar.thumb.background": "#203444",
        "secondary.active.background": "#0d2233",
        "secondary.background": "#011627",
        "secondary.foreground": "#d6deeb",
        "secondary.hover.background": "#0d2233",
        "sidebar.accent.background": "#153856",
        "sidebar.accent.foreground": "#d6deeb",
        "sidebar.background": "#00091a",
        "sidebar.border": "#203444",
        "sidebar.foreground": "#d6deeb",
        "sidebar.primary.background": "#0B2236",
        "sidebar.primary.foreground": "#d6deeb",
        "tab.active.background": "#153856",
        "tab.active.foreground": "#d6deeb",
        "tab.background": "#0B2236",
        "tab.foreground": "#566675",
        "tab_bar.background": "#011627",
        "tab_bar.segmented.background": "#0B2236",
        "title_bar.background": "#00091a",
        "title_bar.border": "#203444",
        "base.magenta.light": "#77609c",
        "base.red": "#ef5350",
        "base.green": "#22da6e",
        "base.yellow": "#addb67",
        "base.blue": "#82aaff",
        "base.magenta": "#c792ea",
        "base.cyan": "#21c7a8",
