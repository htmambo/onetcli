        "editor.active_line_number": "#d6deeb",
        "editor.invisible": "#56667566",
        "conflict": "#ef5350",
        "created": "#22da6e",
        "deleted": "#6f0000",
        "error": "#ef5350",
        "hidden": "#566675",
        "hint": "#645488",
        "ignored": "#566675",
        "info": "#82aaff",
        "modified": "#addb67",
        "predictive": "#5b7dbe",
        "renamed": "#21c7a8",
        "success": "#22da6e",
        "unreachable": "#566675",
        "warning": "#ffeb95",
