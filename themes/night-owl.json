          "attribute": {
            "color": "#ceb8ea"
          },
          "boolean": {
            "color": "#ef5350"
          },
          "comment": {
            "color": "#566675"
          },
          "comment.doc": {
            "color": "#566675"
          },
          "constant": {
            "color": "#ef5350"
          },
          "function": {
            "color": "#82aaff"
          },
          "keyword": {
            "color": "#c792ea"
          },
          "link": {
            "color": "#82aaff",
            "underline": true
          },
          "method": {
            "color": "#82aaff"
          },
          "number": {
            "color": "#ef5350"
          },
          "operator": {
            "color": "#ffffff"
          },
          "predefined": {
            "color": "#21c7a8"
          },
          "string": {
            "color": "#22da6e"
          },
          "type": {
            "color": "#21c7a8"
          },
          "variable": {
            "color": "#d6deeb"
          }
        }
