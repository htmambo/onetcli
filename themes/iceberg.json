        "secondary.hover.background": "#22242d",
        "sidebar.accent.background": "#242738",
        "sidebar.accent.foreground": "#c6c8d1",
        "sidebar.background": "#090b14",
        "sidebar.border": "#30323b",
        "sidebar.foreground": "#c6c8d1",
        "sidebar.primary.background": "#12131e",
        "sidebar.primary.foreground": "#c6c8d1",
        "tab.active.background": "#2A2E44",
        "tab.active.foreground": "#c6c8d1",
        "tab.background": "#1a1c2a",
        "tab.foreground": "#5c5e67",
        "tab_bar.background": "#161821",
        "tab_bar.segmented.background": "#1a1c2a",
        "title_bar.background": "#090b14",
