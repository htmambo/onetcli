        "created": "#b4be82",
        "deleted": "#620000",
        "error": "#e98989",
        "hidden": "#5c5e67",
        "hint": "#5b5574",
        "ignored": "#5c5e67",
        "info": "#91acd1",
        "modified": "#e2a478",
        "predictive": "#637794",
        "renamed": "#89b8c2",
