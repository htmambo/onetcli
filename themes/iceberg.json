          },
          "method": {
            "color": "#84a0c6"
          },
          "number": {
            "color": "#e98989"
          },
          "operator": {
            "color": "#c6c8d1"
          },
          "predefined": {
            "color": "#89b8c2"
          },
          "string": {
            "color": "#b4be82"
          },
          "type": {
            "color": "#89b8c2"
