      "highlight": {
        "editor.foreground": "#d8dee9",
        "editor.background": "#2e3440",
        "editor.active_line.background": "#212733",
        "editor.line_number": "#727883",
        "editor.active_line_number": "#d8dee9",
        "editor.invisible": "#72788366",
        "conflict": "#bf616a",
        "created": "#a3be8c",
        "deleted": "#3f0000",
        "error": "#94545d",
        "hidden": "#727883",
        "hint": "#716176",
        "ignored": "#727883",
        "info": "#68809a",
        "modified": "#ebcb8b",
        "predictive": "#68809a",
        "renamed": "#88c0d0",
        "success": "#a3be8c",
        "unreachable": "#727883",
        "warning": "#b29e75",
        "syntax": {
          "attribute": {
            "color": "#c6b6cb"
          },
          "boolean": {
            "color": "#94545d"
          },
          "comment": {
            "color": "#727883"
          },
          "comment.doc": {
            "color": "#727883"
          },
          "constant": {
            "color": "#94545d"
          },
          "function": {
            "color": "#81a1c1"
          },
          "keyword": {
            "color": "#b48ead"
          },
          "link": {
            "color": "#81a1c1",
            "underline": true
          },
          "method": {
            "color": "#81a1c1"
          },
          "number": {
            "color": "#94545d"
          },
          "operator": {
            "color": "#e5e9f0"
          },
          "predefined": {
            "color": "#88c0d0"
          },
          "string": {
            "color": "#a3be8c"
          },
          "type": {
            "color": "#88c0d0"
          },
          "variable": {
            "color": "#d8dee9"
          }
        }
      }
    }
